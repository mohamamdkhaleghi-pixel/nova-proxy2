{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "4cfa0afd-92f4-4b75-8c1d-7048773e06e8","database_name": "nova-proxy2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d8d004f0f658453a8c40a8274c009bb4" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
